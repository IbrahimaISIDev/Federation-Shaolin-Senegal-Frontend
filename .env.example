# URL de l'API backend (obligatoire)
NEXT_PUBLIC_API_URL=https://api.shaolin-senegal.sn

# URL publique du site (utilisée pour les métadonnées SEO)
NEXT_PUBLIC_SITE_URL=https://shaolin-senegal.sn

# Clé secrète pour JWT (32 caractères minimum, aléatoires)
# Générez avec : openssl rand -base64 32
NEXTAUTH_SECRET=changez_ceci_par_une_vraie_cle_secrete_32_chars

# URL de base pour NextAuth
NEXTAUTH_URL=http://localhost:3000
